# Copy to .env and fill in. Never commit .env.

# Postgres connection. Local Homebrew Postgres example; docker-compose uses postgresql://castly:castly@localhost:5432/castly
DATABASE_URL=postgresql://localhost:5432/castly
# Used by `npm test` only (wiped on every run).
TEST_DATABASE_URL=postgresql://localhost:5432/castly_test

PORT=4000
# Comma-separated list of browser origins allowed to call the API with cookies.
WEB_ORIGIN=http://localhost:5173

# Real xAI key: scripts (grok-4.5), voice (tts) and video (grok-imagine-video). Spends your quota.
XAI_API_KEY=

# Credits granted on sign-up; one credit = one 6s video.
FREE_CREDITS=3
DAILY_SCRIPT_LIMIT=50
DAILY_VOICE_LIMIT=60
MAX_PENDING_VIDEOS=2

# Storage for voice takes, product photos and finished videos: local | s3
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# S3 / Cloudflare R2 (only when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Password-reset email. Without SMTP_URL the email is printed to the server log.
SMTP_URL=
MAIL_FROM="Castly <no-reply@castly.local>"

# Production: serve the built web app from this API (same origin, simplest cookie setup).
# SERVE_WEB_DIST=../web/dist
# COOKIE_SECURE=true
# TRUST_PROXY=true
